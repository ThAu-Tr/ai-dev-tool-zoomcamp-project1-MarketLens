# Local-only isolated observability demo. Copy to .env.observability.
POSTGRES_DB=marketlens_observability
POSTGRES_USER=marketlens
POSTGRES_PASSWORD=change-me-local-only
MARKETLENS_PORT=8001
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_ENVIRONMENT=local-demo
# Optional provider credentials for manual refreshes; add your own keys locally.
EODHD_API_KEY=
MARKETAUX_API_KEY=
MARKETAUX_USER_AGENT=MarketLens/0.1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
